    return color;
}

// Example camera uniform
layout(binding = 1) uniform Camera {
    vec3 position;
    vec3 lowerLeftCorner;
    vec3 horizontal;
    vec3 vertical;
} camera;

// Generate a ray for a given pixel coordinate.
Ray generateCameraRay(ivec2 pixelCoords) {
    // Assume you know the image resolution (passed as a uniform or constant)
    const ivec2 resolution = ivec2(1920, 1080);
    vec2 uv = vec2(pixelCoords) / vec2(resolution);
    Ray r;
    r.origin = camera.position;
    r.direction = normalize(camera.lowerLeftCorner + uv.x * camera.horizontal + uv.y * camera.vertical - camera.position);
    return r;
}


void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    // Generate ray based on camera and pixel coordinates.
    Ray r = generateCameraRay(pixelCoords);
    // Compute color (using a fixed depth, max_t, delta_t, etc.)
    vec3 color = rayColor(r, 5, 10.0, 0.1);
    imageStore(outputImage, pixelCoords, vec4(color, 1.0));
}
